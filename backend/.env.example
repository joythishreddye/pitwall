# ===========================================
# PitWall Backend Environment Variables
# Copy to .env and fill in your values
# ===========================================

# --- Supabase ---
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# --- LLM (Groq) ---
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your_groq_api_key
LLM_PROVIDER=groq
# Any current Groq model id. gpt-oss models reason before answering.
LLM_MODEL=openai/gpt-oss-120b
# Smaller model for intent/entity extraction (separate Groq rate limits)
LLM_INTENT_MODEL=openai/gpt-oss-20b
# low | medium | high (reasoning models only)
LLM_REASONING_EFFORT=low

# --- HuggingFace (query-time embeddings + reranking) ---
# Get from: https://huggingface.co/settings/tokens. Inference needs credits.
HUGGINGFACE_API_TOKEN=hf_your_token
# Hard ceiling on billable HuggingFace requests per UTC month (0 disables them;
# chat then answers from Postgres full-text search).
HF_MONTHLY_CALL_LIMIT=5000

# --- Upstash Redis (optional, unused for now) ---
# UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# --- App Config ---
SECRET_KEY=generate-a-random-string-here
# Shared secret for /health/ready?deep=true (smoke tests, keep-alive cron)
HEALTH_CHECK_TOKEN=generate-another-random-string
DEBUG=false
